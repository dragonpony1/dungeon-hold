{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dungeon-hold",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "HIDEOUT", "class_name": "HideoutDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HideoutDO"] }
  ],
  "observability": { "enabled": true }
}
